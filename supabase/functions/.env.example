# Edge function secrets for sync-content. Set on the VPS in /opt/portal/.env (functions container reads them).
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=
SYNC_SECRET=choose-a-long-random-string

# Easy Read site (self-hosted Supabase on Ryan's Cloud). Use its anon key if the table is readable, else service key.
EASYREAD_API_URL=https://easyread-api.pixelhub.org.uk
EASYREAD_API_KEY=
EASYREAD_TABLE=documents
EASYREAD_ID_COL=id
EASYREAD_TITLE_COL=title
EASYREAD_CATEGORY_COL=category
EASYREAD_STEPS_COL=steps
EASYREAD_BODY_COL=body
EASYREAD_UPDATED_COL=updated_at
EASYREAD_PUBLISHED_COL=published_at
EASYREAD_PUBLISHED_FLAG_COL=
# EASYREAD_RSS_URL=   # set this instead if the site has an RSS feed

# Workshops site
WORKSHOPS_API_URL=https://workshop-api.pixelhub.org.uk
WORKSHOPS_API_KEY=
WORKSHOPS_TABLE=workshops
WORKSHOPS_STEPS_TABLE=
WORKSHOPS_STEPS_FK_COL=workshop_id

# PossAbilities TV
TV_API_URL=
TV_API_KEY=
TV_TABLE=shows
